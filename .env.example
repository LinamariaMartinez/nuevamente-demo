# Copia este archivo como .env y pon tu clave real.
# Se obtiene gratis en https://aistudio.google.com (Get API key).
GEMINI_API_KEY=tu_clave_aqui

# Ruta relativa a la raíz del repositorio. Se crea al iniciar FastAPI.
NUEVAMENTE_DB_PATH=storage/nuevamente.sqlite3
# Opcional: orígenes web, separados por comas. Streamlit llama desde su servidor.
NUEVAMENTE_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Demo para el jurado: claves de ejemplo públicas, solo para datos de demostración.
# Descomenta las tres en .env y ejecuta:
# python -m scripts.crear_cuentas_demo --con-tema-demo --claves-fijas
# Usa los mismos valores en los secretos del frontend para mostrarlos en la landing.
# DEMO_ADMIN_PASSWORD=Jurado-Admin-2026!
# DEMO_ESTUDIANTE_PASSWORD=Jurado-Estudiante-2026!
# DEMO_TEMPORAL_PASSWORD=Jurado-Temporal-2026!

# --- Oracle Cloud Infrastructure (OCI Object Storage - Capa Always Free) ---
# Opción 1: Usar el archivo estándar ~/.oci/config generado en la consola de OCI.
# OCI_CONFIG_FILE=~/.oci/config
# OCI_CONFIG_PROFILE=DEFAULT

# Opción 2: Definir las credenciales directamente por variables de entorno.
# OCI_USER_OCID=ocid1.user.oc1..aaaaaaa...
# OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaa...
# OCI_FINGERPRINT=xx:xx:xx:...
# OCI_KEY_FILE=~/.oci/oci_api_key.pem
OCI_REGION=us-ashburn-1
OCI_BUCKET_NAME=nuevamente-contenidos-educativos
# Opcionales (si se omiten, se resuelven automáticamente con la tenencia):
# OCI_NAMESPACE=tu_namespace
# OCI_COMPARTMENT_OCID=ocid1.tenancy.oc1..aaaaaaa...
